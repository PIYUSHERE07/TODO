<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/output.css">
  <title>TodoHome</title>
</head>
<body>
  <div class="main">
    <div class="box">
      <div class="todo-form">
        <form action="/todo-added" method="POST">
          <div class="left">
            <label for="todoTopic">Enter Task</label>
            <input type="text" name="todoTopic" id="todoTopic">
          </div>
          <div class="middle">
            <label for="todoDate">Date</label>
            <input type="date" name="todoDate" id="todoDate">
          </div>
          <div class="right">
            <button type="submit">Add Todo</button>
          </div>
        </form>
      </div>
      <div class="todo-list">

      </div>
    </div>
  </div>
</body>
</html>