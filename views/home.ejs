<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/output.css">
  <title>TodoHome</title>
</head>
<body>
  <% if(isLoggedIn){ %>
  <a href="/logout">Log-out</a>
  <a href="/deleteAcc">Delete Account</a>
  <div class="main">
    <div class="box">
      <div class="todo-form">
        <form action="/" method="POST">
          <div class="left">
            <label for="todoTopic">Enter Task</label>
            <input type="text" name="todoTopic" id="todoTopic" >
          </div>
          <div class="middle">
            <label for="todoDate">Date</label>
            <input type="date" name="todoDate" id="todoDate" required>
          </div>
          <div class="right">
            <button type="submit">Add Todo</button>
          </div>
        </form>
        <%if(errorMessage){%>
          <div class="errors">
            <ul>
            <%errorMessage.forEach(err=>{%>
              <li><%=err%></li>
            <%})%>
            </ul>
          </div>
      <%}%>
      </div>
    </div>
    <% if(todoList){ %>
      <% todoList.forEach(todo=>{ %>
      <div class="todo">
        <div class="todo-task"><%=todo.task%></div>
        <div class="todo-date"><%=todo.date%></div>
        <div class="todo-delete">
          <form action="/delete" method="post">
            <button type="submit">Delete</button>
            <input type="hidden" name="todoId" value="<%=todo._id%>">
          </form>
        </div>
      </div>
      <% }) %>
    <%}%>
  </div>
  <% } else{ %>
      <div class="login-box">
      <form action="/login" method="post">
        <div class="username">
          <label for="username">Username</label>
          <input type="text" name="username" id="username">
        </div>
        <div class="password">
          <label for="password">Password</label>
          <input type="password" name="password" id="password">
        </div>
        <div class="login-button">
          <button type="submit">Login</button>
        </div>
      </form>
      <div class="sendToOpp">
        I do not have account? <a href="/signup">sign-up</a>
      </div>
    </div>
  <%}%>
</body>
</html>